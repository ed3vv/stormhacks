:root {
    --ink: #1B2033;
    --ink-hi: #2A3150;
    --ink-lo: #0E1220;
    --paper: #FFF3D6;
    --paper-lo: #E6CF9C;
    --paper-dim: rgba(255, 243, 214, 0.62);
    --gold: #FFC23D;
    --gold-hi: #FFD86E;
    --gold-lo: #8A5A00;
    --ice: #8FD6FF;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

.row {
    flex-direction: row;
    align-items: center;
}

.display {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/LilitaOne-Regular-SDF.asset");
}

.eyebrow {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-ExtraBold-SDF.asset");
    font-size: 13px;
    letter-spacing: 2.5px;
    color: var(--gold);
    white-space: nowrap;
    flex-shrink: 0;
}

.shadowed {
    text-shadow: 0px 2px 0px rgb(14, 18, 32);
}

.key {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-ExtraBold-SDF.asset");
    font-size: 14px;
    color: var(--ink);
    background-color: var(--paper);
    border-radius: 6px;
    border-bottom-width: 4px;
    border-bottom-color: var(--paper-lo);
    min-width: 32px;
    height: 32px;
    padding: 0 9px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}

.key--small {
    font-size: 12px;
    min-width: 24px;
    height: 24px;
    padding: 0 6px;
    border-bottom-width: 3px;
    border-radius: 5px;
}

/* ------------------------------------------------------------ scorecard (top left) */

.scorecard {
    position: absolute;
    left: 40px;
    top: 52px;
    align-items: flex-start;
}

.pennant {
    padding: 14px 80px 18px 30px;
    margin-bottom: 20px;
    --fill: #E5383B;
    --light: #FF5A5C;
    --depth-color: #8E1B1F;
    --depth: 6;
}

.biome-desert .pennant {
    --fill: #D9622B;
    --light: #F08A4B;
    --depth-color: #8A3714;
}

.biome-basin .pennant {
    --fill: #2F6FC4;
    --light: #4E92E6;
    --depth-color: #163A6E;
}

.pennant-map {
    color: var(--paper);
}

.pennant-title-row {
    align-items: flex-end;
    margin-top: 2px;
}

.pennant-title {
    font-size: 58px;
    color: var(--paper);
    text-shadow: 0px 3px 0px rgba(0, 0, 0, 0.22);
}

.pennant-of {
    font-size: 26px;
    color: rgba(255, 243, 214, 0.72);
    margin-left: 8px;
    padding-bottom: 9px;
}

.pips {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    height: 22px;
}

.pip {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    --fill: rgba(255, 243, 214, 0.3);
    --light: rgba(255, 243, 214, 0.3);
    --depth: 0;
}

.pip--done {
    --fill: #FFF3D6;
    --light: #FFFFFF;
}

.pip--now {
    width: 22px;
    height: 22px;
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth: 3;
    --depth-color: rgba(0, 0, 0, 0.3);
}

.chips {
    flex-direction: row;
    margin-left: 10px;
}

.chip {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px 10px;
    margin-right: 10px;
    --cut: 8;
    --depth: 4;
}

.chip-label {
    font-size: 17px;
}

.chip-value {
    font-size: 23px;
    color: var(--gold);
    margin-left: 7px;
}

.chip-sealed {
    margin-top: 12px;
    margin-left: 10px;
    --fill: #163A6E;
    --light: #23518F;
}

.chip-icon {
    width: 16px;
    height: 20px;
    margin-right: 9px;
    --fill: #C49BFF;
    --light: #EADBFF;
    --depth: 0;
}

/* ------------------------------------------------------------ stats (top right) */

.stats {
    position: absolute;
    right: 40px;
    top: 52px;
    flex-direction: row;
    align-items: flex-start;
}

.stat {
    padding: 14px 24px 16px;
    margin-left: 12px;
    min-width: 150px;
    --cut: 14;
    --depth: 6;
}

.stat-launch {
    flex-direction: row;
    align-items: center;
}

.stat-value-row {
    align-items: flex-end;
    margin-top: 2px;
}

.stat-value {
    font-size: 54px;
    color: var(--paper);
}

.stat-unit {
    font-size: 24px;
    color: rgba(255, 243, 214, 0.7);
    margin-left: 4px;
    padding-bottom: 8px;
}

.stat-unit--deg {
    font-size: 30px;
    padding-bottom: 26px;
    margin-left: 2px;
}

.stat-gauge {
    width: 54px;
    height: 54px;
    margin-left: 20px;
}

/* ------------------------------------------------------------ puzzle hint card (top centre) */

.hint-card {
    position: absolute;
    top: 44px;
    left: 50%;
    translate: -50% 0;
    width: 720px;
    padding: 18px 26px 22px;
    --cut: 16;
    --depth: 6;
}

.hint-head {
    justify-content: space-between;
}

.hint-hide {
    font-size: 14px;
    color: var(--paper-dim);
}

.hint-title {
    font-size: 23px;
    margin-top: 6px;
}

.hint-body {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-Medium-SDF.asset");
    font-size: 17px;
    color: rgba(255, 243, 214, 0.86);
    white-space: normal;
    margin-top: 6px;
}

/* ------------------------------------------------------------ centre banner */

.banner-slot {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
}

.banner {
    max-width: 1180px;
    padding: 16px 88px 20px;
    align-items: center;
    opacity: 0;
    translate: 0 -36px;
    scale: 0.9 0.9;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth-color: #8A5A00;
    --depth: 7;
}

.banner--shown {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.banner-title {
    font-size: 64px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

.banner-sub {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-ExtraBold-SDF.asset");
    font-size: 18px;
    letter-spacing: 1px;
    color: var(--ink);
    white-space: nowrap;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.banner--info {
    --fill: #1B2033;
    --light: #2A3150;
    --depth-color: #0E1220;
}

.banner--info .banner-title {
    font-size: 46px;
    color: var(--paper);
}

.banner--info .banner-sub {
    color: var(--gold);
}

/* ------------------------------------------------------------ bottom stack */

.bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    align-items: center;
}

.prompt {
    padding: 10px 24px 12px;
    flex-direction: row;
    align-items: center;
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth-color: #8A5A00;
    --cut: 10;
}

.bottom--prompt .hints {
    display: none;
}

.prompt-text {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-ExtraBold-SDF.asset");
    font-size: 19px;
    color: var(--ink);
}

.status {
    padding: 7px 16px 9px;
    margin-bottom: 16px;
    --cut: 8;
    --depth: 4;
}

.status-text {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-Medium-SDF.asset");
    font-size: 15px;
}

.inventory {
    flex-direction: row;
    margin-bottom: 20px;
}

.slot {
    width: 88px;
    height: 88px;
    margin: 0 6px;
    align-items: center;
    justify-content: center;
    --cut: 14;
    --depth: 6;
}

.slot--held {
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth-color: #8A5A00;
}

.slot--empty {
    opacity: 0.45;
}

.slot-key {
    position: absolute;
    left: 8px;
    top: 8px;
}

.slot-icon {
    width: 36px;
    height: 40px;
    margin-top: 4px;
}

.slot-icon--mirror {
    --fill: #9AD9EF;
    --light: #E9FBFF;
}

.slot-icon--diffractor {
    width: 40px;
    --fill: #C49BFF;
    --light: #EADBFF;
    --depth: 0;
}

.slot-count {
    position: absolute;
    right: 10px;
    bottom: 4px;
    font-size: 26px;
}

.slot--held .slot-count {
    color: var(--ink);
}

.power {
    width: 620px;
    margin-bottom: 34px;
}

.power-head {
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 6px;
}

.power-label {
    color: var(--paper);
    font-size: 15px;
    letter-spacing: 3px;
    text-shadow: 0px 2px 0px rgb(14, 18, 32);
}

.power-pct {
    font-size: 44px;
    text-shadow: 0px 3px 0px rgb(14, 18, 32);
}

.power-track {
    padding: 10px 12px;
    --cut: 10;
    --depth: 6;
}

.power-bar {
    height: 28px;
}

.pole-label {
    position: absolute;
    top: 44px;
    translate: -50% 0;
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-ExtraBold-SDF.asset");
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ice);
    text-shadow: 0px 2px 0px rgb(14, 18, 32);
    white-space: nowrap;
}

.hints {
    flex-direction: row;
    align-items: center;
    padding: 11px 14px 13px;
    --cut: 12;
    --depth: 5;
}

.hint-item {
    flex-direction: row;
    align-items: center;
    margin: 0 12px;
}

.hint-action {
    font-size: 18px;
    margin-left: 4px;
}

.hint-note {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-Medium-SDF.asset");
    font-size: 17px;
    margin: 0 12px;
}

.footer {
    position: absolute;
    left: 40px;
    bottom: 44px;
    flex-direction: row;
    align-items: center;
}

.footer-label {
    font-size: 15px;
    margin-right: 18px;
    text-shadow: 0px 2px 0px rgb(14, 18, 32);
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34px;
    height: 34px;
    translate: -50% -50%;
    --fill: #FFF3D6;
    --stroke: #FFF3D6;
    --depth-color: rgba(14, 18, 32, 0.8);
}

.crosshair--target {
    --fill: #FFC23D;
    --stroke: #FFC23D;
}

/* ------------------------------------------------------------ waypoint markers */

.marker {
    position: absolute;
    align-items: center;
    translate: -50% -15px;
}

.marker-icon {
    width: 30px;
    height: 30px;
}

.marker-arrow {
    position: absolute;
    left: 7px;
    top: 7px;
    width: 16px;
    height: 13px;
    --fill: #FFF3D6;
    --depth-color: #0E1220;
}

.marker-tag {
    margin-top: 6px;
    padding: 3px 11px 6px;
    --cut: 6;
    --depth: 3;
}

.marker-label {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-ExtraBold-SDF.asset");
    font-size: 15px;
    white-space: nowrap;
}

.marker--cup .marker-icon {
    --fill: #E5383B;
    --light: #FF5A5C;
    --stroke: #FFF3D6;
}

.marker--gem .marker-icon {
    --fill: #C49BFF;
    --light: #EADBFF;
    --depth: 3;
}

.marker--pole .marker-icon {
    --fill: #8FD6FF;
}

.marker--pole .marker-label {
    color: var(--ice);
}

.marker--ball .marker-icon {
    --fill: #FFFFFF;
}

/* ------------------------------------------------------------ menus */

.menu-layer {
    background-color: rgba(9, 11, 20, 0.8);
    align-items: center;
    justify-content: center;
}

.menu-title {
    align-self: center;
    padding: 14px 90px 18px;
    margin-bottom: 34px;
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth-color: #8A5A00;
    --depth: 7;
}

.menu-title-label {
    font-size: 54px;
    color: var(--ink);
}

.menu-foot {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 30px;
}

.menu-foot-label {
    font-size: 16px;
    color: var(--paper-dim);
    margin-right: 22px;
}

.levels {
    width: 1500px;
}

.levels-columns {
    flex-direction: row;
}

.level-col {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 12px;
}

.level-col-head {
    align-self: flex-start;
    padding: 10px 62px 12px 26px;
    margin: 10px 0 22px;
    --fill: #E5383B;
    --light: #FF5A5C;
    --depth-color: #8E1B1F;
    --depth: 5;
}

.level-col-head--desert {
    --fill: #D9622B;
    --light: #F08A4B;
    --depth-color: #8A3714;
}

.level-col-head--basin {
    --fill: #2F6FC4;
    --light: #4E92E6;
    --depth-color: #163A6E;
}

.level-col-title {
    font-size: 30px;
}

.level-col-sub {
    font-size: 12px;
    color: var(--paper);
}

.level-card {
    flex-direction: row;
    align-items: center;
    padding: 12px 20px 14px 18px;
    margin-bottom: 12px;
    --cut: 12;
    --depth: 5;
}

.level-card:hover {
    --fill: #333B5E;
    --light: #3F4872;
}

.level-card--current {
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth-color: #8A5A00;
}

.level-card--current:hover {
    --fill: #FFCB55;
    --light: #FFE08A;
}

.level-num {
    font-size: 36px;
    color: var(--gold);
    width: 46px;
}

.level-text {
    flex-grow: 1;
}

.level-card-title {
    font-size: 19px;
}

.level-card-sub {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-Medium-SDF.asset");
    font-size: 14px;
    color: var(--paper-dim);
    margin-top: 2px;
}

.level-best {
    font-size: 22px;
    color: var(--gold);
}

.level-best--none {
    color: rgba(255, 243, 214, 0.3);
}

.level-card--current .level-num,
.level-card--current .level-card-title,
.level-card--current .level-best {
    color: var(--ink);
}

.level-card--current .level-card-sub {
    color: rgba(27, 32, 51, 0.7);
}

.pause {
    flex-direction: row;
    align-items: flex-start;
}

.pause-left {
    margin-right: 28px;
    width: 380px;
}

.pause-left .menu-title {
    align-self: stretch;
}

.menu-button {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 22px 18px 26px;
    margin-bottom: 14px;
    --cut: 12;
    --depth: 6;
}

.menu-button:hover {
    --fill: #333B5E;
    --light: #3F4872;
}

.menu-button--primary {
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth-color: #8A5A00;
}

.menu-button--primary:hover {
    --fill: #FFCB55;
    --light: #FFE08A;
}

.menu-button-label {
    font-size: 26px;
}

.menu-button--primary .menu-button-label {
    color: var(--ink);
}

.controls {
    width: 780px;
    padding: 24px 30px 18px;
    --cut: 18;
    --depth: 7;
}

.controls-heading {
    font-size: 34px;
    margin-bottom: 4px;
}

.controls-group {
    margin-top: 16px;
    margin-bottom: 8px;
}

.controls-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.control {
    flex-direction: row;
    align-items: center;
    margin-right: 22px;
    margin-bottom: 10px;
}

.control-action {
    -unity-font-definition: url("project://database/Assets/S3/UI/Fonts/Rubik-Medium-SDF.asset");
    font-size: 16px;
}

.results {
    align-items: center;
}

.sc-table {
    padding: 22px 30px 24px;
    --cut: 18;
    --depth: 7;
}

.sc-row {
    flex-direction: row;
    align-items: center;
}

.sc-name {
    width: 130px;
    font-size: 18px;
}

.sc-head {
    width: 74px;
    margin: 0 4px 8px;
    -unity-text-align: middle-center;
}

.sc-cell {
    width: 74px;
    height: 58px;
    margin: 4px;
    align-items: center;
    justify-content: center;
    --cut: 10;
    --depth: 4;
    --fill: #2A3150;
    --light: #333B5E;
}

.sc-cell--total {
    width: 104px;
}

.sc-cell--under {
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth-color: #8A5A00;
}

.sc-cell--over {
    --fill: #7A2935;
    --light: #8F3443;
    --depth-color: #3D1219;
}

.sc-cell--par-row {
    --fill: transparent;
    --light: transparent;
    --depth: 0;
}

.sc-val {
    font-size: 30px;
}

.sc-cell--under .sc-val {
    color: var(--ink);
}

.sc-cell--par-row .sc-val {
    color: var(--paper-dim);
    font-size: 24px;
}

.sc-summary {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    margin-top: 26px;
}

.sc-big {
    font-size: 72px;
    color: var(--gold);
    text-shadow: 0px 4px 0px rgb(14, 18, 32);
}

.sc-big-label {
    white-space: nowrap;
    font-size: 15px;
    letter-spacing: 3px;
    margin: 0 0 18px 14px;
    color: var(--paper);
}

/* ------------------------------------------------------------ hole complete */

.menu-layer--light {
    background-color: rgba(9, 11, 20, 0.35);
}

.hole-card {
    align-items: center;
    opacity: 0;
    scale: 0.8 0.8;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}

.hole-card--in {
    opacity: 1;
    scale: 1 1;
}

.hole-card-eyebrow {
    font-size: 15px;
    letter-spacing: 4px;
    color: var(--paper);
    text-shadow: 0px 2px 0px rgb(14, 18, 32);
    margin-bottom: 14px;
}

.hole-card-title {
    padding: 16px 100px 22px;
    --fill: #FFC23D;
    --light: #FFD86E;
    --depth-color: #8A5A00;
    --depth: 8;
}

.hole-card-title--plain {
    --fill: #1B2033;
    --light: #2A3150;
    --depth-color: #0E1220;
}

.hole-card-name {
    font-size: 76px;
    color: var(--ink);
}

.hole-card-title--plain .hole-card-name {
    color: var(--paper);
}

.hole-card-line {
    font-size: 22px;
    margin-top: 22px;
    text-shadow: 0px 2px 0px rgb(14, 18, 32);
}

.hole-card-buttons {
    flex-direction: row;
    margin-top: 28px;
}

.hole-card-buttons .menu-button {
    min-width: 250px;
    margin: 0 8px;
}

/* ------------------------------------------------------------ instant replay */

.replay-card {
    position: absolute;
    top: 44px;
    left: 50%;
    translate: -50% 0;
    min-width: 480px;
    padding: 16px 30px 22px;
    align-items: center;
    --cut: 14;
    --depth: 6;
}

.replay-eyebrow {
    font-size: 15px;
    letter-spacing: 4px;
}

.replay-line {
    font-size: 20px;
    margin-top: 6px;
}

.replay-track {
    width: 380px;
    height: 8px;
    margin-top: 14px;
    border-radius: 4px;
    background-color: rgba(255, 243, 214, 0.15);
}

.replay-fill {
    width: 0;
    height: 8px;
    border-radius: 4px;
    background-color: var(--gold);
}
